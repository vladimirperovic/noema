# Noema example configuration
# Copy this file to .env and change values for your deployment.
# Never commit .env, credentials, tokens, private keys, personal data, or production IDs.

# --- Server ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000

# --- Access control ---
# Bearer token for MCP, OpenAPI tools, and machine clients.
# Leave empty only for isolated local development.
NOEMA_API_TOKEN=

# Password protecting the browser UI and normal REST routes.
UI_PASSWORD=

# --- Encryption at rest ---
# Passphrase used to derive the AES-256-GCM key for data/*.json.
# Set this explicitly in production and back it up separately from encrypted data.
ENCRYPTION_KEY=

# --- Date and browser policy ---
# IANA timezone used for yesterday/today/tomorrow boundaries.
NOEMA_TIMEZONE=UTC

# Allowed browser origin. Use the exact production URL instead of * when deployed.
NOEMA_CORS_ORIGIN=*

# Identify your installation when calling external public services.
# Include an operator URL or email when required by the service policy.
NOEMA_HTTP_USER_AGENT=Noema/0.1 (self-hosted; contact: admin@example.com)

# --- Google Calendar (optional, read-only) ---
# Create an OAuth Web application and register:
# <PUBLIC_BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary
GOOGLE_REFRESH_TOKEN=

# --- Optional Stats and SEO dashboard ---
# JSON array of projects. Keep real property IDs and private domains only in .env.
# The same service account must have access to the configured GA4 and Search Console properties.
#
# Fields:
# id, name, url, ga4PropertyId, gscSites[], brandTerms[], color, badge
#
# Example:
# NOEMA_ANALYTICS_PROJECTS=[{"id":"example","name":"example.com","url":"https://example.com","ga4PropertyId":"123456789","gscSites":["sc-domain:example.com","https://example.com/"],"brandTerms":["example"],"color":"#64748b","badge":"EX"}]
NOEMA_ANALYTICS_PROJECTS=

GA4_CLIENT_EMAIL=
# PEM can contain real line breaks or literal \n sequences.
GA4_PRIVATE_KEY=
PAGESPEED_API_KEY=
