# Noema 0.3 example configuration
# Copy to .env and change every security-sensitive value before production use.
# Never commit .env, credentials, tokens, private keys, personal data, or production IDs.

# --- Server ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
NOEMA_DATA_DIR=
NOEMA_TIMEZONE=UTC

# Explicit development-only escape hatch. Do not enable on an Internet-facing deployment.
ALLOW_INSECURE_NO_AUTH=false

# --- Access control ---
# Required in production unless ALLOW_INSECURE_NO_AUTH=true.
# This is the single Noema master password: it signs into the browser UI and
# protects the installation data-encryption key stored in data/master.key.
UI_PASSWORD=
NOEMA_API_TOKEN=

# Exact browser origin. Production refuses the wildcard value.
NOEMA_CORS_ORIGIN=*

# UI session lifetime.
SESSION_IDLE_HOURS=24
SESSION_ABSOLUTE_HOURS=168

# Comma-separated source addresses of reverse proxies allowed to supply X-Forwarded-For.
# Discover the actual peer address from your container or proxy logs; do not add client networks.
NOEMA_TRUSTED_PROXY_IPS=

# --- Encryption and backups ---
# Legacy migration only. Existing installations that previously used a separate
# ENCRYPTION_KEY may keep it for the first startup/login after upgrading. After
# one successful login migrates master.key to v3:wrapped, this value can be removed.
ENCRYPTION_KEY=

# Password used for encrypted .noema disaster-recovery archives. Minimum 12 characters.
NOEMA_BACKUP_PASSWORD=

# Default validity of newly generated gallery share links. Individual links may override it.
GALLERY_SHARE_TTL_DAYS=30

# Files are stored below NOEMA_DATA_DIR/files. The application limit is 120 MB per file.

# --- External HTTP identity ---
NOEMA_HTTP_USER_AGENT=Noema/0.3 (self-hosted; contact: admin@example.com)

# --- Google Calendar (optional, read-only) ---
# Register <PUBLIC_BASE_URL>/auth/google/callback in Google Cloud.
# The refresh token obtained through the UI is encrypted in NOEMA_DATA_DIR/google-token.enc.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary
GOOGLE_REFRESH_TOKEN=

# --- Optional Stats and SEO dashboard ---
# Keep real property IDs and private domains only in .env.
# Example:
# NOEMA_ANALYTICS_PROJECTS=[{"id":"example","name":"example.com","url":"https://example.com","ga4PropertyId":"123456789","gscSites":["sc-domain:example.com"],"brandTerms":["example"],"color":"#64748b","badge":"EX"}]
NOEMA_ANALYTICS_PROJECTS=
GA4_CLIENT_EMAIL=
# PEM can contain real line breaks or literal \n sequences.
GA4_PRIVATE_KEY=
PAGESPEED_API_KEY=
